{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlphaHedge Desk",
  "version": "0.1.0",
  "identifier": "com.alphahedge.desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AlphaHedge Desk",
        "width": 1360,
        "height": 900,
        "minWidth": 980,
        "minHeight": 560,
        "visible": false,
        "backgroundColor": "#111111"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
